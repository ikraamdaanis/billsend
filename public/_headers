# Cache rules for the static assets Cloudflare serves from public/ and the
# build. By default every file is revalidated on each visit (max-age=0), which
# costs a round trip before the hero painting can draw.

# Vite's build output: file names carry a content hash, so a changed file
# always gets a new URL and these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Homepage pictures and fonts keep their names. Cache them for a month and
# refresh in the background after that; give a replaced image a new file name
# so visitors pick it up straight away.
/home/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
